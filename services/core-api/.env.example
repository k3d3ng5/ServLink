# Copy to services/core-api/.env (gitignored). Never commit real keys.
# Dev now: SQLite (no server needed). Pilot later: postgres://... (ADR-003).
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgres://servlink:servlink_dev_only@localhost:5432/servlink
PORT=3001
PUBLIC_API_URL=http://localhost:3001
# Phone LAN URL(s), comma-separated — must match the app's API_URL for login.
TRUSTED_ORIGINS=http://192.168.1.6:3001
# Plus, for browser clients (Expo web, public site), append their origins:
# http://localhost:8081,http://localhost:8082,http://localhost:19000,https://<site>.netlify.app
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
FOLLOWUP_DELAY_MIN=60
OFFER_WINDOW_MIN=5
MAX_AUTO_OFFERS=3
RESEND_API_KEY=re_change_me
# Gmail SMTP fallback (pilot, until the domain lands). Needs 2FA + App Password:
# Google Account → Security → 2-Step Verification → App passwords → Mail → copy.
GMAIL_USER=change_me
GMAIL_APP_PASSWORD=change_me_16_chars_no_spaces
GROQ_API_KEY=gsk_change_me
GROQ_MODEL=openai/gpt-oss-20b
TELEGRAM_BOT_TOKEN=change_me_for_notify_only
ADMIN_CHAT_IDS=change_me_for_admin_alerts
R2_ACCOUNT_ID=change_me
R2_ACCESS_KEY_ID=change_me
R2_SECRET_ACCESS_KEY=change_me
R2_BUCKET=servlink-pilot
PAYSTACK_SECRET_KEY=sk_test_change_me
