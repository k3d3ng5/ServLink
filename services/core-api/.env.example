# Copy to services/core-api/.env (gitignored). Never commit real keys.
# Dev now: SQLite (no server needed). Pilot later: postgres://... (ADR-003).
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgres://servlink:servlink_dev_only@localhost:5432/servlink
PORT=3001
PUBLIC_API_URL=http://localhost:3001
# Phone LAN URL(s), comma-separated — must match the app's API_URL for login.
TRUSTED_ORIGINS=http://192.168.1.13:3001
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
FOLLOWUP_DELAY_MIN=60
OFFER_WINDOW_MIN=5
MAX_AUTO_OFFERS=3
RESEND_API_KEY=re_change_me
TELEGRAM_BOT_TOKEN=change_me_for_notify_only
ADMIN_CHAT_IDS=change_me_for_admin_alerts
R2_ACCOUNT_ID=change_me
R2_ACCESS_KEY_ID=change_me
R2_SECRET_ACCESS_KEY=change_me
R2_BUCKET=servlink-pilot
PAYSTACK_SECRET_KEY=sk_test_change_me
