// Prisma schema — dev runs SQLite (agent-session Postgres is unstable, ADR-003).
// Postgres stays the pilot target: schema uses only compatible types/Changing
// `provider` to "postgresql" + a fresh migration is the entire switch.
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        String    @id @default(cuid())
  phone     String?   @unique
  email     String?   @unique
  name      String?
  channel   String    // app | telegram | whatsapp (later)
  handle    String?
  telegramChatId String?  // set on OTP login — bot access requires it
  createdAt DateTime  @default(now())
  requests  ServiceRequest[]
}

model Provider {
  id               String    @id @default(cuid())
  name             String
  phone            String    @unique
  email            String?
  ninLast4         String?   // NIN verification: format-checked at intake, vendor-verified later
  ninVerified      Boolean   @default(false)
  telegramChatId   String?
  isOnline         Boolean @default(false)
  latitude         Float?
  longitude        Float?
  serviceRadiusKm  Float     @default(10)
  categories       String    // JSON array of category ids
  zones            String    // JSON array of zone ids
  tier             String    @default("Basic") // Basic | Verified | Professional
  verificationStatus String  @default("pending")
  availability     String?
  createdAt        DateTime  @default(now())
  jobs             Job[]
}

model ProviderApplication {
  id           String   @id @default(cuid())
  name         String
  phone        String
  categories   String   // JSON array
  zones        String   // JSON array
  telegramChatId String?
  email        String?
  consentAt    DateTime?  // explicit consent to NIN/ID processing (NDPA)
  nin          String?   // raw NIN held only until verification; never returned by API
  idType       String?   // nin_slip | voters_card | drivers_license | passport
  latitude     Float?
  longitude    Float?
  skillNote    String?
  photoUrl     String?
  status       String   @default("pending") // pending | approved | rejected
  reviewedBy   String?
  createdAt    DateTime @default(now())
}

model Zone {
  id   String @id
  name String @unique
}

model Category {
  id   String @id
  name String @unique
}

model ServiceRequest {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  categoryId    String?
  zoneId        String @default("general") // auto-assigned: nearest zone centroid, or "general"
  address       String
  latitude      Float?
  longitude     Float?
  description   String
  preferredTime String?
  sourceChannel String
  status        String    @default("REQUESTED")
  createdAt     DateTime  @default(now())
  jobs          Job[]
  events        StatusEvent[]
}

model Job {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  providerId String
  provider  Provider       @relation(fields: [providerId], references: [id])
  matchedBy String         // concierge | system
  matchedAt DateTime       @default(now())
  confirmedAt DateTime?
  startedAt DateTime?
  // Bilateral completion: both sides must agree before "done properly?" is asked.
  providerDoneAt DateTime?
  customerDoneAt DateTime?
  doneAt    DateTime?
  // Paystack (post-job collection; pilot: customer pays after confirming work)
  amountKobo    Int?
  laborKobo     Int?
  materialsKobo Int?       @default(0)
  materialsNote String?
  paystackRef   String?   @unique
  paymentStatus String    @default("unpaid") // unpaid | pending | paid | failed
  paidAt        DateTime?
  followUps FollowUp[]
  ratings   Rating[]
  reworks   ReworkTicket[]
  offers    JobOffer[]
}

model JobOffer {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  providerId String
  status     String   @default("pending") // pending | accepted | declined | expired
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model StatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  fromStatus String
  toStatus   String
  actor      String
  note       String?
  at         DateTime       @default(now())
}

model FollowUp {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  sentAt      DateTime @default(now())
  channel     String
  response    String?
  confirmedOk Boolean?
}

model Rating {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id])
  score  Int
  note   String?
}

model ReworkTicket {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id])
  reason String
  status String @default("open")
}

// Better Auth tables (email-OTP login for bot + app).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Assistant chat sessions (Groq chatbot driving the same request workflow).
model ChatSession {
  id        String        @id @default(cuid())
  email     String?
  channel   String        @default("app")
  state     String        @default("{}") // JSON: collected slots
  requestId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // user | assistant | system-note
  content   String
  createdAt DateTime    @default(now())
}
